# Dependencies (installed inside image via composer install)
vendor/
node_modules/

# Local environment — NEVER bake secrets into the image!
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# Tests & dev tools
tests/
phpunit.xml
.phpunit.result.cache

# Editor & OS
.editorconfig
.vscode/
.DS_Store
Thumbs.db

# Logs
storage/logs/*.log

# Build artifacts
public/hot
public/storage

# Local bootstrap cache — these are generated by artisan at runtime inside the container.
# Baking them into the image would embed dev-only service providers (e.g. laravel/pail)
# that are not installed in the production image (--no-dev).
bootstrap/cache/*.php

# Docker files (not needed inside container)
Dockerfile
.dockerignore

# CI
.github/
