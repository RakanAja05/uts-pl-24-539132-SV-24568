# =============================================================================
# .env.example — Root Docker Compose environment template
# Copy to .env and fill in the values before running docker compose up
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: cd backend && php artisan key:generate --show
APP_KEY=base64:CHANGE_ME_generate_with_php_artisan_key_generate_show
APP_URL=http://localhost

# ── Database ──────────────────────────────────────────────────────────────────
DB_DATABASE=plant_db
DB_USERNAME=plant_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Port mapping (host ports exposed by docker compose) ───────────────────────
FRONTEND_PORT=80
BACKEND_PORT=8000
